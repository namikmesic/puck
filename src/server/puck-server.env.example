# Configuration for the local Puck server (docker compose). Copy this file to
# ./puck-server.env at the repository root; that copy is git-ignored because
# it holds secrets. Leave the GitHub block commented out to run without
# GitHub (the server still starts; sign-in answers 503).

# Public URL apps and runners use. Keep it in step with the published port.
# PUCK_SERVER_URL=http://localhost:8765

# Oldest runner version the server accepts (MAJOR.MINOR.PATCH).
# PUCK_RUNNER_MIN_VERSION=

# --- GitHub App (all five, or none) ---
# The App's callback URL must be <PUCK_SERVER_URL>/v1/auth/github/callback.
# PUCK_GITHUB_APP_ID=
# PUCK_GITHUB_CLIENT_ID=
# PUCK_GITHUB_APP_SLUG=
# PUCK_GITHUB_CLIENT_SECRET=
# The App's private key, base64-encoded on one line: base64 < key.pem | tr -d '\n'
# (or PUCK_GITHUB_PRIVATE_KEY_FILE=<path> where the engine can mount a file).
# PUCK_GITHUB_PRIVATE_KEY=
# 32 random bytes, base64 (openssl rand -base64 32). Losing it signs every
# user out of GitHub; rotating it means everyone signs in again.
# PUCK_SERVER_TOKEN_KEY=
