{
  "root": true,
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "ignorePatterns": [
    ".webpack/",
    "out/",
    "dist/",
    "coverage/",
    "src/main/runner/runner.js"
  ],
  "settings": {
    "import/core-modules": [
      "raw-runner",
      "vitest/config"
    ]
  },
  "overrides": [
    {
      "files": [
        "src/server/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/channel/e2e",
                  "**/channel/e2e.ts"
                ],
                "message": "The Puck server relays channels without holding keys; it must not import the channel encryption."
              },
              {
                "group": [
                  "electron",
                  "**/main/**",
                  "**/renderer/**"
                ],
                "message": "The Puck server runs outside the app; it may import only src/server, src/channel and src/harness."
              }
            ]
          }
        ]
      }
    }
  ]
}
