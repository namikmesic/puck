{
  "root": true,
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "rules": {
    "import/no-unresolved": ["error", { "ignore": ["\\?raw$"] }]
  },
  "ignorePatterns": [
    ".webpack/",
    "out/",
    "dist/",
    "coverage/"
  ],
  "settings": {
    "import/core-modules": [
      "raw-daemon",
      "raw-daemon-meta",
      "vitest/config"
    ]
  },
  "overrides": [
    {
      "files": [
        "src/harness/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "src/harness is shared with the renderer and the daemon: no electron."
              }
            ],
            "patterns": [
              {
                "group": [
                  "node:*"
                ],
                "message": "src/harness is pure: no Node built-ins."
              },
              {
                "group": [
                  "**/runner-release",
                  "**/runner-release/**"
                ],
                "message": "src/harness is pure: the runner-release verifier (Node crypto) imports it, never the other way."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/daemon/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The daemon runs in containers: no electron."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/main",
                  "**/main/**",
                  "**/renderer",
                  "**/renderer/**",
                  "**/runner-release",
                  "**/runner-release/**"
                ],
                "message": "The daemon may import only src/harness and itself."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/server/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/channel/e2e",
                  "**/channel/e2e.ts",
                  "**/channel/stream",
                  "**/channel/stream.ts"
                ],
                "message": "The Puck server relays channels without holding keys; it must not import the channel encryption."
              },
              {
                "group": [
                  "electron",
                  "**/main/**",
                  "**/renderer/**",
                  "**/puck-runner/**",
                  "**/daemon/**"
                ],
                "message": "The Puck server runs outside the app; it may import only src/server, src/channel (not its encryption), src/harness and src/runner-release."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/puck-runner/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "puck-runner runs on runner hosts: no electron."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/main",
                  "**/main/**",
                  "**/renderer",
                  "**/renderer/**",
                  "**/daemon",
                  "**/daemon/**",
                  "**/server",
                  "**/server/**"
                ],
                "message": "puck-runner may import only src/puck-runner, src/channel, src/harness and src/runner-release."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/main/**/*.ts",
        "src/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/daemon",
                  "**/daemon/**"
                ],
                "message": "The app talks to the daemon over its protocol; it never imports daemon code."
              },
              {
                "group": [
                  "**/puck-runner",
                  "**/puck-runner/**"
                ],
                "message": "The app talks to runners over the control protocol; it never imports runner code."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/renderer/**/*.ts",
        "src/renderer.ts",
        "src/preload.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/daemon",
                  "**/daemon/**"
                ],
                "message": "The app talks to the daemon over its protocol; it never imports daemon code."
              },
              {
                "group": [
                  "**/puck-runner",
                  "**/puck-runner/**"
                ],
                "message": "The app talks to runners over the control protocol; it never imports runner code."
              },
              {
                "group": [
                  "**/runner-release",
                  "**/runner-release/**"
                ],
                "message": "Runner releases are verified in the main process (src/runner-release); the renderer and preload never import it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/runner-release/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "src/runner-release is shared by the server, the app's main process and the runner: no electron."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/main",
                  "**/main/**",
                  "**/renderer",
                  "**/renderer/**",
                  "**/daemon",
                  "**/daemon/**",
                  "**/server",
                  "**/server/**",
                  "**/puck-runner",
                  "**/puck-runner/**",
                  "**/channel",
                  "**/channel/**"
                ],
                "message": "src/runner-release may import only src/harness, itself and node:crypto."
              }
            ]
          }
        ],
        "import/no-nodejs-modules": [
          "error",
          {
            "allow": [
              "node:crypto"
            ]
          }
        ]
      }
    }
  ]
}
