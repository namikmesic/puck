{
  "root": true,
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "ignorePatterns": [
    ".webpack/",
    "out/",
    "dist/",
    "coverage/",
    "src/main/runner/runner.js"
  ],
  "settings": {
    "import/core-modules": [
      "raw-runner",
      "raw-daemon",
      "raw-daemon-meta",
      "vitest/config"
    ]
  },
  "overrides": [
    {
      "files": [
        "src/harness/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "src/harness is shared with the renderer and the daemon: no electron."
              }
            ],
            "patterns": [
              {
                "group": [
                  "node:*"
                ],
                "message": "src/harness is pure: no Node built-ins."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/daemon/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The daemon runs in containers: no electron."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/main",
                  "**/main/**",
                  "**/renderer",
                  "**/renderer/**"
                ],
                "message": "The daemon may import only src/harness and itself."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/server/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/channel/e2e",
                  "**/channel/e2e.ts"
                ],
                "message": "The Puck server relays channels without holding keys; it must not import the channel encryption."
              },
              {
                "group": [
                  "electron",
                  "**/main/**",
                  "**/renderer/**"
                ],
                "message": "The Puck server runs outside the app; it may import only src/server, src/channel and src/harness."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/main/**/*.ts",
        "src/renderer/**/*.ts",
        "src/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/daemon",
                  "**/daemon/**"
                ],
                "message": "The app talks to the daemon over its protocol; it never imports daemon code."
              }
            ]
          }
        ]
      }
    }
  ]
}
