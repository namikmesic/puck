{
  "name": "puck",
  "productName": "Puck",
  "version": "0.0.1",
  "description": "A macOS desktop client for coding agents — Claude Code and Codex conversations running in Docker sandboxes.",
  "main": ".webpack/main",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "node scripts/forge.mjs package",
    "make": "node scripts/forge.mjs make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx,.mjs .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node test/e2e/smoke.mjs"
  },
  "author": {
    "name": "Namik Mesic",
    "email": "hi@namikmesic.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "43.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "jsdom": "^30.0.1",
    "node-loader": "^2.1.0",
    "playwright-core": "^1.62.1",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "~5.4.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  }
}
